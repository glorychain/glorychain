{
  "name": "@glorychain/postgres",
  "version": "0.1.0",
  "type": "module",
  "description": "glorychain Postgres connector",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
